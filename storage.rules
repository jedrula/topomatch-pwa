rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    // Allow anyone to read files
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Allow uploads to location-images folder with nested paths (for location-specific images)
    match /location-images/{locationId}/{imageId} {
      allow write: if true && 
        request.resource.size < 25 * 1024 * 1024 && // 25MB limit
        request.resource.contentType.matches('image/.*');
    }
    
    // Allow uploads to location-images root (for hero images during location creation)
    match /location-images/{imageId} {
      allow write: if true && 
        request.resource.size < 25 * 1024 * 1024 && // 25MB limit
        request.resource.contentType.matches('image/.*');
    }
    
    // Allow uploads to hero-images folder (for location hero images)
    match /hero-images/{imageId} {
      allow write: if true && 
        request.resource.size < 25 * 1024 * 1024 && // 25MB limit
        request.resource.contentType.matches('image/.*');
    }
    
    // Allow uploads to beta videos in locations
    match /locations/{locationId}/problems/{problemId}/videos/{videoId} {
      allow write: if true && 
        request.resource.size < 100 * 1024 * 1024 && // 100MB limit for videos
        request.resource.contentType.matches('video/.*');
      allow delete: if true; // Allow deletion of videos
    }
  }
}
