# Production environment variables
# Used when running: npm run build (or npm run deploy:frontend)

# Firebase Cloud Messaging VAPID Key (for push notifications)
# Get from Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=BLPGAEdXNWdKPJbEd6FEBlIXkOE5neVKGZl1ixMcyKSxGt7-ulTfRBd2qibyNaYI2p2OIVdomaFPOrRFrsUV4xI

# Web Push VAPID Public Key (for Safari/iOS support)
# Generated with: npx web-push generate-vapid-keys
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=BGbfzXzFt91kH-nZL6C3NiivC3VOKoh5OZsZPie6XUFKUSXwlhzR1R6Zao3y9ukT6o5C9L27xR4PIVMmqhRaoAg

# TODO: Re-enable new worker once OpenCV linkElementRoot issue is resolved
# Currently fails in production but works in preview (possible COEP/service worker issue)
VITE_USE_NEW_WORKER=false

# Hold Detection & Image Matching API (SAM2 + LoFTR server)
VITE_HOLD_DETECTION_API_URL=https://8f169051e333.ngrok-free.app

# EXPERIMENTAL: Use server-side LoFTR homography instead of frontend SuperPoint homography
# Requires backend to return homography_matrix in /api/v1/match-images response
VITE_USE_SERVER_HOMOGRAPHY=true

# Short circuit beta upload modal - skip "Upload or Record" screen, go directly to file picker
# Set to true to hide Record Video feature and streamline UX for early users
VITE_BETA_UPLOAD_SHORT_CIRCUIT=true
