# Production environment variables
# Used when running: npm run build (or npm run deploy:frontend)

VITE_USE_NEW_WORKER=false

# Hold Detection & Image Matching API (SAM2 + LoFTR server)
VITE_HOLD_DETECTION_API_URL=https://e55d276f3008.ngrok-free.app

# EXPERIMENTAL: Use server-side LoFTR homography instead of frontend SuperPoint homography
# Requires backend to return homography_matrix in /api/v1/match-images response
VITE_USE_SERVER_HOMOGRAPHY=true
