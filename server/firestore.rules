rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection - users can read/write their own profile, admins can read all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
      allow create: if isAuthenticated(); // Allow users to create their profile
    }

    // Locations collection
    match /locations/{locationId} {
      allow read: if true; // Public read access for browsing
      allow write: if isAdmin(); // Only admins can create/edit/delete locations
      
      // Boulder problems subcollection
      match /boulderProblems/{problemId} {
        allow read: if true; // Public read access
        allow write: if isAdmin(); // Only admins can create/edit/delete problems
        
        // Ascents subcollection within boulder problems
        match /ascents/{ascentId} {
          allow read: if true; // Public read access for leaderboards/ascent history
          allow create: if isAuthenticated(); // Logged-in users can log ascents
          allow update, delete: if isOwner(resource.data.userId) || isAdmin();
        }
      }
      
      // Manual holds subcollection
      match /manualHolds/{holdDocId} {
        allow read: if true; // Public read access - manual holds are shared
        allow write: if isAuthenticated(); // Authenticated users can contribute manual holds
      }
      
      // Hold detections subcollection (unified AI + manual holds)
      match /holdDetections/{imageId} {
        allow read: if true; // Public read access - hold detection results are shared
        allow write: if isAuthenticated(); // Authenticated users can contribute manual holds and save AI detection results
      }
    }

    // Location images
    match /locationImages/{imageId} {
      allow read: if true; // Public read access
      allow write: if isAdmin(); // Only admins can manage images
    }

    // Boulder problems (top-level collection - keeping for compatibility)
    match /boulderProblems/{problemId} {
      allow read: if true; // Public read access
      allow write: if isAdmin(); // Only admins can create/edit/delete problems
    }

    // Ascents - users can manage their own ascents, admins can manage all
    match /ascents/{ascentId} {
      allow read: if isAuthenticated(); // Logged-in users can see ascents
      allow create: if isAuthenticated(); // Logged-in users can log ascents
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Videos - similar to ascents
    match /videos/{videoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Climb videos with transcoding - users can manage their own videos
    match /climbVideos/{videoId} {
      allow read: if isAuthenticated(); // All authenticated users can view videos
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid; // Users can only create videos for themselves
      allow update: if isOwner(resource.data.userId) || isAdmin(); // Users can update their own videos, admins can update all
      allow delete: if isOwner(resource.data.userId) || isAdmin(); // Users can delete their own videos, admins can delete all
    }

    // Admin-only collections
    match /adminSettings/{document} {
      allow read, write: if isAdmin();
    }

    // App configuration - authenticated users can read, only admins can write
    match /app-config/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Audit logs - admin read-only
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only server can write audit logs
    }
  }
}
