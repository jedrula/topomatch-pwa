BACKFILL_BATCH_SIZE=3
CACHE_CONTROL_HEADER=public, max-age=31536000, immutable
CONTENT_FILTER_LEVEL=OFF
DELETE_ORIGINAL_FILE=false
DO_BACKFILL=true
firebaseextensions.v1beta.function/location=us-central1
FUNCTION_MEMORY=512
IMAGE_TYPE=jpeg,webp,false
IMG_BUCKET=${param:STORAGE_BUCKET}
IMG_SIZES=300x300,800x600,1920x1440
IS_ANIMATED=true
MAKE_PUBLIC=true
OUTPUT_OPTIONS={"jpeg": {"quality": 85, "progressive": true}, "webp": {"quality": 80, "effort": 6}}
REGENERATE_TOKEN=false
SHARP_OPTIONS={"fit": "inside", "position": "centre", "withoutEnlargement": true}
