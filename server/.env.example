# Firebase Cloud Functions Environment Variables

# IMPORTANT: Firebase Emulators use .env.local (not .env)
# Copy this file to .env.local for emulator development
# Copy this file to .env.production for production deployment

# Web Push VAPID Keys (for Safari/iOS push notifications)
# Generated with: npx web-push generate-vapid-keys
# Public key should also be added to frontend .env files
WEB_PUSH_VAPID_PUBLIC_KEY=BH6bb3iqhRVcZtLL8fxHWcou0WsmNlXxv_WkuGO6zIciCMBuGf3-2xbM2ITQmLOIfZmdnxlYs8zD9PdCcb1oVMA
WEB_PUSH_VAPID_PRIVATE_KEY=0OlHyL1GXttN7zARdceGWIs6GQWnkb-dpiBvx3TQ3nA
WEB_PUSH_CONTACT=mailto:your-email@example.com

# Hold Detection Server URL
# Update this when your ngrok URL changes
HOLD_DETECTION_SERVER_URL=https://c31c8f31de2b.ngrok-free.app

# Note: .env.local and .env.production are gitignored for security
# Each developer should create their own .env.local file with their local ngrok URL
