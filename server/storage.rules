rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public read access to all files
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Location images - only admins can upload/delete
    // Folder structure: location-images/{locationId}/{imageId}/original.ext
    // Extension creates resized versions in same folder: original_300x300.webp, etc.
    match /location-images/{locationId}/{imageId}/{filename} {
      allow write, delete: if isAdmin() && 
        request.resource.size < 25 * 1024 * 1024 && // 25MB limit
        request.resource.contentType.matches('image/.*');
    }
    
    // Location images root - only admins can upload/delete
    match /location-images/{imageId} {
      allow write, delete: if isAdmin() && 
        request.resource.size < 25 * 1024 * 1024 && // 25MB limit
        request.resource.contentType.matches('image/.*');
    }
    
    // Hero images - only admins can upload/delete
    match /hero-images/{imageId} {
      allow write, delete: if isAdmin() && 
        request.resource.size < 25 * 1024 * 1024 && // 25MB limit
        request.resource.contentType.matches('image/.*');
    }
    
    // User ascent videos - users can upload their own, admins can manage all
    match /ascent-videos/{userId}/{videoId} {
      allow write: if (isOwner(userId) || isAdmin()) && 
        request.resource.size < 100 * 1024 * 1024 && // 100MB limit for videos
        request.resource.contentType.matches('video/.*');
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // Problem beta videos - only admins can manage
    match /locations/{locationId}/problems/{problemId}/videos/{videoId} {
      allow write, delete: if isAdmin() && 
        request.resource.size < 100 * 1024 * 1024 && // 100MB limit for videos
        request.resource.contentType.matches('video/.*');
    }
    
    // Location-level videos - only admins can manage
    match /locations/{locationId}/location-videos/{videoId} {
      allow write, delete: if isAdmin() && 
        request.resource.size < 100 * 1024 * 1024 && // 100MB limit for videos
        request.resource.contentType.matches('video/.*');
    }
    
    // Raw videos for transcoding - users can upload their own
    match /videos/raw/{userId}/{videoId} {
      allow write: if isOwner(userId) && 
        request.resource.size < 500 * 1024 * 1024 && // 500MB limit (will be transcoded)
        request.resource.contentType.matches('video/.*');
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // Transcoded videos - read-only for users, only Cloud Functions can write
    match /videos/transcoded/{userId}/{videoId}/{filename} {
      allow write: if false; // Only Cloud Functions can write transcoded videos
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Analysis diagnostic images - any authenticated user can write their own,
    // anyone can read (covered by the global read rule above).
    match /diagnostics/{ascentId}/{filename} {
      allow write: if isAuthenticated() &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
