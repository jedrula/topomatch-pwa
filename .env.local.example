# Environment variables for local development
# Copy this file to .env.local and update with your settings

# Firebase Cloud Messaging VAPID Key (for push notifications - Chrome/Firefox/Edge)
# Get from Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
# VITE_FIREBASE_VAPID_KEY=your-vapid-key-here

# Web Push VAPID Public Key (for Safari/iOS support)
# Generated with: npx web-push generate-vapid-keys
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=BH6bb3iqhRVcZtLL8fxHWcou0WsmNlXxv_WkuGO6zIciCMBuGf3-2xbM2ITQmLOIfZmdnxlYs8zD9PdCcb1oVMA

# Network IP replacement for mobile access to Firebase emulators
# Replace with your computer's actual IP address on your local network
# Find your IP with: ifconfig | grep inet (macOS/Linux) or ipconfig (Windows)
VITE_LOCALHOST_REPLACEMENT=http://192.168.1.149:9199

# Auto-detect network IP (alternative to manual setting above)
# VITE_AUTO_DETECT_NETWORK_IP=true

# Other possible Firebase emulator ports:
# Firestore: 8080
# Auth: 9099  
# Functions: 5001
# Storage: 9199 (used above)

# AI Model Mocking and Threading (for memory testing)
# VITE_USE_OPENCV_MOCK=true       # Use recorded fixtures for homography (saves ~20 MB)
# VITE_USE_INFERENCE_MOCK=true    # Use mock YOLO inference (saves ~49 MB model)
# VITE_USE_MAIN_THREAD_INFERENCE=true  # Run inference in main thread (no worker, blocks UI)
# VITE_USE_NEW_WORKER=true        # Use new ES modules worker (ONNX Runtime best practices)
