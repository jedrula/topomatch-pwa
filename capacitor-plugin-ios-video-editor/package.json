    "build": "echo 'No build needed - Swift only'"
  },
  "devDependencies": {
    "@capacitor/core": "^6.0.0"
  },
  "peerDependencies": {
    "@capacitor/core": "^6.0.0"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    }
  }
