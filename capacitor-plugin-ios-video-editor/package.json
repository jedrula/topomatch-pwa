{
  "name": "capacitor-plugin-ios-video-editor",
  "version": "0.0.1",
  "description": "iOS native video editor - trim and compress",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "ios/",
    "src/",
    "*.podspec"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "author": "TopoMatch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "local"
  },
  "bugs": {
    "url": "local"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "ios",
    "video"
  ],
  "scripts": {
    "verify": "npm run verify:ios",
