{
  "name": "topomatch-pwa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node concat.js",
    "dev": "vite",
    "prebuild": "node concat.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "emulators": "firebase emulators:start --import=./firebase-emulator-data --export-on-exit=./firebase-emulator-data",
    "emulators:reset": "rm -rf ./firebase-emulator-data && firebase emulators:start --export-on-exit=./firebase-emulator-data",
    "emulators:export": "firebase emulators:export ./firebase-emulator-data",
    "server:build": "cd server && npm run build",
    "server:dev": "cd server && npm run build:watch",
    "backup:export": "node scripts/backup.cjs export",
    "backup:import": "node scripts/backup.cjs import",
    "backup:export:prod": "node scripts/backup.cjs export-prod",
    "backup:import:prod": "node scripts/backup.cjs import-prod",
    "backup:package": "node scripts/backup.cjs package",
    "backup:import:seed": "node scripts/backup.cjs import-seed",
    "backup:list": "node scripts/backup.cjs list"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.1",
    "@tailwindcss/vite": "^4.1.11",
    "@techstark/opencv-js": "^4.11.0-release.1",
    "bowser": "^2.11.0",
    "firebase": "^12.0.0",
    "floating-vue": "^2.0.0",
    "onnxruntime-web": "^1.22.0",
    "pinia": "^3.0.3",
    "tailwindcss": "^4.1.11",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "wasm-feature-detect": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "eslint": "^9.22.0",
    "eslint-plugin-oxlint": "^0.16.0",
    "eslint-plugin-vue": "~10.0.0",
    "globals": "^16.0.0",
    "npm-run-all2": "^7.0.2",
    "oxlint": "^0.16.0",
    "vite": "^6.2.4",
    "vite-plugin-pwa": "^1.0.0",
    "vite-plugin-static-copy": "^3.0.0",
    "vite-plugin-vue-devtools": "^7.7.2"
  }
}
