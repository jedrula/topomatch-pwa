{
  "name": "topomatch-pwa",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node concat.js",
    "dev": "vite --host",
    "prebuild": "node concat.js",
    "build": "vite build",
    "build:test": "vite build --mode production-test",
    "preview": "vite preview",
    "test": "playwright test tests/pose-detection-regression.test.js",
    "test:baseline": "playwright test tests/generate-baseline.spec.js",
    "test:ui": "playwright test --ui",
    "type-check": "vue-tsc --noEmit",
    "type-check:watch": "vue-tsc --noEmit --watch",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "backup:export": "node scripts/backup.cjs export",
    "backup:import": "node scripts/backup.cjs import",
    "backup:export:prod": "node scripts/backup.cjs export-prod",
    "backup:import:prod": "node scripts/backup.cjs import-prod",
    "backup:package": "node scripts/backup.cjs package",
    "backup:import:seed": "node scripts/backup.cjs import-seed",
    "backup:list": "node scripts/backup.cjs list",
    "deploy:frontend": "npm run build && cp server/firebase.json firebase.json && firebase deploy --only hosting",
    "deploy:test": "npm run build:test && cp server/firebase.json firebase.json && firebase deploy --only hosting",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:build": "npm run build && npm run ios:sync && ./scripts/cleanup-ios-assets.sh && npm run ios:open",
    "story:dev": "histoire dev",
    "story:build": "histoire build",
    "story:preview": "histoire preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.0.1",
    "@capacitor-firebase/functions": "^8.0.1",
    "@capacitor-firebase/messaging": "^8.0.1",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@headlessui/vue": "^1.7.23",
    "@huggingface/transformers": "^3.7.1",
    "@imengyu/vue3-context-menu": "^1.5.4",
    "@tailwindcss/vite": "^4.1.11",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "@vueform/slider": "^2.1.10",
    "bowser": "^2.11.0",
    "browser-image-compression": "^2.0.2",
    "capacitor-plugin-ios-video-editor": "file:capacitor-plugin-ios-video-editor",
    "firebase": "^12.0.0",
    "floating-vue": "^2.0.0",
    "form-data": "^4.0.4",
    "glob": "^11.0.3",
    "node-fetch": "^3.3.2",
    "onnxruntime-web": "^1.22.0",
    "pinia": "^3.0.3",
    "tailwindcss": "^4.1.11",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "wasm-feature-detect": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.57.0",
    "@storybook/vue3-vite": "^9.1.3",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.22.0",
    "eslint-plugin-oxlint": "^0.16.0",
    "eslint-plugin-storybook": "^9.1.3",
    "eslint-plugin-vue": "~10.0.0",
    "globals": "^16.0.0",
    "npm-run-all2": "^7.0.2",
    "oxlint": "^0.16.0",
    "storybook": "^9.1.3",
    "typescript": "^5.6.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vite-plugin-static-copy": "^3.0.0",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vue-tsc": "^2.2.0"
  }
}
